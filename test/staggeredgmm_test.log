. do staggeredgmm_test.do

. * Test script for staggeredgmm.
. *
. * Run from this test/ directory:   do staggeredgmm_test.do
. *
. * Uses the ado files in the parent directory, not any installed copy, and the
. * example dataset sgmm_sim_panel.dta from the parent directory. Every check
. * is self-contained: exact recovery on noiseless data, the J-test restriction
. * counts of the simulated design, invariances, error handling, stored results
. * and postestimation, including designs with a single treated cohort. Runs
. * with varabbrev off, as required for SSC.
. 
. version 16

. clear all

. set more off

. set varabbrev off

. set linesize 120

. 
. local here "`c(pwd)'"

. adopath ++ "`here'/.."
  [1]              "/Users/rishabhbijani/Desktop/staggeredGMM_local/staggeredgmm_stata/test/.."
  [2]  (BASE)      "/Applications/StataNow/ado/base/"
  [3]  (SITE)      "/Applications/StataNow/ado/site/"
  [4]              "."
  [5]  (PERSONAL)  "/Users/rishabhbijani/Documents/Stata/ado/personal/"
  [6]  (PLUS)      "/Users/rishabhbijani/Library/Application Support/Stata/ado/plus/"
  [7]  (OLDPLACE)  "~/ado/"

. discard

. local sim "`here'/../sgmm_sim_panel.dta"

. 
. global sgmm_fail 0

. global sgmm_pass 0

. global sgmm_failed ""

. 
. program sgmm_record
  1.         args case what ok detail
  2.         if `ok' {
  3.                 global sgmm_pass = $sgmm_pass + 1
  4.         }
  5.         else {
  6.                 global sgmm_fail = $sgmm_fail + 1
  7.                 global sgmm_failed "$sgmm_failed `case':`what'"
  8.                 di as err "  FAIL `case' `what' `detail'"
  9.         }
 10. end

. 
. program sgmm_expect_error
  1.         gettoken name 0 : 0
  2.         gettoken rc cmd : 0
  3.         capture `cmd'
  4.         local got = _rc
  5.         sgmm_record E `name' `=`got' == `rc'' "expected rc `rc', got `got'"
  6. end

. 
. * A noiseless panel: cohorts 3 and 4 (two units each), two never-treated units,
. * four periods, effects (3,3) = 1, (3,4) = 2, (4,4) = 3.
. program sgmm_noiseless
  1.         clear
  2.         quietly set obs 24
  3.         quietly gen long unit_id = ceil(_n / 4)
  4.         quietly gen int year = _n - (unit_id - 1) * 4
  5.         quietly gen int cohort = cond(unit_id <= 2, 3, cond(unit_id <= 4, 4, 0))
  6.         quietly gen double tau = 0
  7.         quietly replace tau = 1 if cohort == 3 & year == 3
  8.         quietly replace tau = 2 if cohort == 3 & year == 4
  9.         quietly replace tau = 3 if cohort == 4 & year == 4
 10.         quietly gen double y = unit_id / 10 + year^2 / 7 + tau
 11.         drop tau
 12. end

. 
. * A noiseless panel with one treated cohort g (four units) and three
. * never-treated units over T periods; the effect at event time e is 1 + e.
. program sgmm_onecohort
  1.         args g T
  2.         clear
  3.         quietly set obs `=7 * `T''
  4.         quietly gen long unit_id = ceil(_n / `T')
  5.         quietly gen int year = _n - (unit_id - 1) * `T'
  6.         quietly gen int cohort = cond(unit_id <= 4, `g', 0)
  7.         quietly gen double y = unit_id / 10 + year^2 / 7 + ///
>                 cond(cohort > 0 & year >= cohort, 1 + year - cohort, 0)
  8. end

. 
. di _n as txt "{hline 70}" _n "Estimation" _n "{hline 70}"

----------------------------------------------------------------------
Estimation
----------------------------------------------------------------------

. 
. * exact recovery on a noiseless panel, under every weighting
. foreach w in pooled_toeplitz cohort_toeplitz unrestricted {
  2.         sgmm_noiseless
  3.         quietly staggeredgmm y, ivar(unit_id) time(year) gvar(cohort) weighting(`w')
  4.         tempname C
  5.         matrix `C' = e(catt)
  6.         local ok = abs(`C'[1,4] - 1) < 1e-8 & abs(`C'[2,4] - 2) < 1e-8 & abs(`C'[3,4] - 3) < 1e-8
  7.         local ok = `ok' & `C'[1,1] == 3 & `C'[2,1] == 3 & `C'[3,1] == 4 & `C'[3,2] == 4 & `C'[2,3] == 1
  8.         sgmm_record A exact_recovery_`w' `ok' ""
  9. }

. 
. * J-test restriction counts on the simulated panel (70 full, 14 local, base 9)
. quietly use "`sim'", clear

. quietly staggeredgmm y, ivar(unit_id) time(year) gvar(cohort)

. quietly estat jtest, full

. sgmm_record A jtest_full_70 `=r(n_moments) == 70 & r(base_period) == 9' ""

. quietly estat jtest

. sgmm_record A jtest_local_14 `=r(n_moments) == 14' ""

. tempname m

. matrix `m' = r(moments)

. local ok 1

. forvalues i = 1/`=rowsof(`m')' {
  2.         if `m'[`i', 2] >= `m'[`i', 1] | `m'[`i', 2] == 9 local ok 0
  3. }

. sgmm_record A jtest_placebo_pretreatment `ok' ""

. sgmm_record A jtest_p_formula `=reldif(r(p), chi2tail(r(df), r(J))) < 1e-12' ""

. sgmm_record A jtest_scope `="`r(scope)'" == "unconditional"' ""

. 
. * _b[] naming and agreement with e(catt)
. tempname Cc agg

. matrix `Cc' = e(catt)

. matrix `agg' = e(w_cw) * `Cc'[1..., 4]

. sgmm_record A b_naming `=abs(_b[g10:t10] - `Cc'[1, 4]) < 1e-12' ""

. sgmm_record A aggregate_identity `=reldif(e(att_cw), `agg'[1, 1]) < 1e-12' ""

. 
. * e(N) counts non-missing outcomes, e(N_rows) every row
. preserve

. quietly replace y = . in 5/9

. quietly staggeredgmm y, ivar(unit_id) time(year) gvar(cohort)

. sgmm_record A N_nonmissing `=e(N) == 1975 & e(N_rows) == 1980' "N=`=e(N)' N_rows=`=e(N_rows)'"

. restore

